# Puerto en el que correrá tu backend dentro del contenedor
PORT=3000

# Conexión a Azure Database for PostgreSQL
# ⚠️ Reemplaza usuario, password, servidor y nombre_bd con tus datos reales
DATABASE_URL="postgresql://usuario:password@NOMBRE-SERVIDOR.postgres.database.azure.com:5432/nombre_bd?sslmode=require"

# Clave secreta usada para firmar JWT
JWT_SECRET="clave_super_segura_para_tokens"

# Entorno
NODE_ENV=production
